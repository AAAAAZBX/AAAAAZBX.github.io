---
import { getMergedPosts } from '../../lib/content-posts';
import { getHomeTotalPages } from '../../lib/home-pagination';
import { withBase } from '../../lib/base-url';

export async function getStaticPaths() {
  const merged = await getMergedPosts();
  const total = getHomeTotalPages(merged.length);
  if (total <= 1) return [];
  const paths: { params: { page: string } }[] = [];
  for (let p = 2; p <= total; p++) {
    paths.push({ params: { page: String(p) } });
  }
  return paths;
}

return Astro.redirect(withBase(import.meta.env.BASE_URL, '#notes'), 301);
---
