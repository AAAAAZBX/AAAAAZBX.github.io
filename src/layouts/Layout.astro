---
import SiteHeader from "../components/SiteHeader.astro";
import ThemeInit from "../components/ThemeInit.astro";
import VisitorScripts from "../components/VisitorScripts.astro";
import { defaultHeroImage } from "../lib/site-images";
import { withBase } from "../lib/base-url";

const {
  title = "Boxuan Zhang",
  description: metaDescription = "Personal blog — algorithms, systems, and machine learning notes.",
  /** Absolute or site-relative OG image path */
  ogImage,
  isArticle = false,
  overlayNav = false,
  hideNav = false,
  noindex = false,
  hasMath = false,
  /** 整页固定为暗色主题令牌（不随顶栏昼夜切换改变控制台样式） */
  lockPageDarkTheme = false,
} = Astro.props;
const year = new Date().getFullYear();
/** 与 public 资源、Service Worker 注册一致（支持子路径部署） */
const baseUrl = import.meta.env.BASE_URL;
const siteOrigin = Astro.site ?? new URL(import.meta.env.SITE || "https://aaaaazbx.github.io");
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin).href;
const ogImageAbsolute = (() => {
  if (!ogImage) return new URL(defaultHeroImage(baseUrl), siteOrigin).href;
  if (ogImage.startsWith("http")) return ogImage;
  return new URL(withBase(baseUrl, ogImage.replace(/^\/+/, "")), siteOrigin).href;
})();
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={isArticle ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImageAbsolute} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <script is:inline define:vars={{ visibilityUrl: import.meta.env.PUBLIC_SUPABASE_URL, visibilityKey: import.meta.env.PUBLIC_SUPABASE_ANON_KEY }}>
      // Share one request between the homepage and the site-wide visibility filter.
      window.__bxHiddenPosts = visibilityUrl && visibilityKey
        ? fetch(visibilityUrl + '/rest/v1/content_visibility?select=hidden_posts&id=eq.1', {
            headers: { apikey: visibilityKey, Authorization: 'Bearer ' + visibilityKey },
            signal: AbortSignal.timeout(5000)
          }).then(function (response) {
            if (!response.ok) throw new Error('Visibility unavailable');
            return response.json();
          })
        : null;
      // Consumers retain their server-rendered fallback on failure.
      if (window.__bxHiddenPosts) window.__bxHiddenPosts.catch(function () {});
    </script>
    
    <ThemeInit />

    <!-- Favicon - 使用头像作为标签栏图标 -->
    <link rel="icon" type="image/png" href={withBase(baseUrl, "logo.png")} />
    <link rel="shortcut icon" type="image/png" href={withBase(baseUrl, "logo.png")} />

    <!-- 与 lynx-li.github.io 文章页一致：Bootstrap 栅格 + GitHub Markdown 底座，再由 global 覆盖主题 -->
    <link
      rel="stylesheet"
      href="https://lib.baomitu.com/twitter-bootstrap/4.6.1/css/bootstrap.min.css"
    />
    <link
      rel="stylesheet"
      href="https://lib.baomitu.com/github-markdown-css/4.0.0/github-markdown.min.css"
    />
    <link rel="stylesheet" href={withBase(baseUrl, "styles/global.css")} />

    <!-- Fluid 顶栏图标（与 Lynx Li Hexo Fluid iconfont 一致） -->
    <link rel="stylesheet" href="https://at.alicdn.com/t/c/font_1749284_5i9bdhy70f8.css" />
    <link rel="stylesheet" href="https://at.alicdn.com/t/c/font_1736178_k526ubmyhba.css" />

    <!-- KaTeX 样式，用于渲染公式 -->
    {hasMath && <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.7/dist/katex.min.css" />}

  </head>

  <body
    class:list={[overlayNav && "home-fluid-index", lockPageDarkTheme && "page-theme-lock-dark"]}
  >
    {!hideNav && <SiteHeader overlay={overlayNav} />}

    {
      lockPageDarkTheme ? (
        <div class="dark page-theme-lock-wrap">
          <slot />
          <footer>© {year} Boxuan Zhang</footer>
        </div>
      ) : (
        <>
          <slot />
          <footer>© {year} Boxuan Zhang</footer>
        </>
      )
    }

    <VisitorScripts />

    <script>
      import "../scripts/hero-effects";

      document.addEventListener("DOMContentLoaded", () => {
        // 平滑滚动
        const scrollBehavior = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
        document.documentElement.style.scrollBehavior = scrollBehavior;

        // 移除当前页面链接的高亮（用户要求：只有悬停时才显示蓝色）
        // 不再添加 active 类和 aria-current 属性

        // 代码块复制按钮 + 超长代码折叠
        const COLLAPSE_LINES = 20;
        document.querySelectorAll("pre.astro-code").forEach((pre) => {
          if (pre.querySelector("button.code-copy")) return;

          const btn = document.createElement("button");
          btn.className = "code-copy";
          btn.textContent = "Copy";

          btn.addEventListener("click", async () => {
            const code = pre.querySelector("code");
            if (!code) return;
            const text = code.innerText;

            try {
              await navigator.clipboard.writeText(text);
              const old = btn.textContent;
              btn.textContent = "Copied";
              setTimeout(() => (btn.textContent = old), 1500);
            } catch (e) {
              console.error(e);
            }
          });

          pre.appendChild(btn);

          const code = pre.querySelector("code");
          if (!code || pre.dataset.foldInit === "1") return;
          pre.dataset.foldInit = "1";

          const raw = (code.textContent || "").replace(/\n$/, "");
          const lineCount = raw ? raw.split("\n").length : 0;
          if (lineCount <= COLLAPSE_LINES) return;

          const codeStyle = window.getComputedStyle(code);
          const preStyle = window.getComputedStyle(pre);
          const lineHeight = parseFloat(codeStyle.lineHeight) || 20;
          const padTop = parseFloat(preStyle.paddingTop) || 0;
          const padBottom = parseFloat(preStyle.paddingBottom) || 0;
          const collapsedHeight = Math.ceil(lineHeight * COLLAPSE_LINES + padTop + padBottom + 2);

          const wrapper = document.createElement("div");
          wrapper.className = "code-collapse-wrap";
          pre.parentNode?.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          const toggle = document.createElement("button");
          toggle.className = "code-toggle";
          toggle.type = "button";
          toggle.textContent = "Expand";

          const setCollapsed = (collapsed) => {
            pre.classList.toggle("is-collapsed", collapsed);
            pre.style.maxHeight = collapsed ? `${collapsedHeight}px` : "none";
            wrapper.classList.toggle("is-expanded", !collapsed);
            toggle.textContent = collapsed ? "Expand" : "Collapse";
            toggle.setAttribute("aria-expanded", collapsed ? "false" : "true");
          };

          toggle.addEventListener("click", () => {
            const collapsed = pre.classList.contains("is-collapsed");
            setCollapsed(!collapsed);
          });

          pre.classList.add("code-collapsible");
          wrapper.appendChild(toggle);
          setCollapsed(true);
        });

        // Markdown 内部目录链接的高亮功能
        const article = document.querySelector("#board .markdown-body");
        if (!article) return;

        // 获取所有锚点链接（href 以 # 开头的链接）
        const anchorLinks = article.querySelectorAll('a[href^="#"]');
        if (anchorLinks.length === 0) return;

        // 获取所有标题元素
        const headings = article.querySelectorAll("h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]");
        if (headings.length === 0) return;

        // 更新激活链接的函数
        const updateActiveLink = () => {
          const hash = window.location.hash;
          anchorLinks.forEach((link) => {
            link.classList.remove("active");
            if (hash && link.getAttribute("href") === hash) {
              link.classList.add("active");
            }
          });
        };

        // 使用 Intersection Observer 来检测当前可见的标题
        const observerOptions = {
          rootMargin: "-20% 0px -70% 0px",
          threshold: 0,
        };

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              if (id) {
                // 更新 URL（不创建历史记录）
                const url = window.location.pathname + `#${id}`;
                window.history.replaceState(null, "", url);
                
                // 更新激活的链接
                anchorLinks.forEach((link) => {
                  link.classList.remove("active");
                  if (link.getAttribute("href") === `#${id}`) {
                    link.classList.add("active");
                  }
                });
              }
            }
          });
        }, observerOptions);

        // 观察所有标题
        headings.forEach((heading) => observer.observe(heading));

        // 点击链接时的处理
        anchorLinks.forEach((link) => {
          link.addEventListener("click", (e) => {
            e.preventDefault();
            const targetId = link.getAttribute("href")?.substring(1);
            const target = document.getElementById(targetId || "");
            if (target) {
              target.scrollIntoView({ behavior: scrollBehavior, block: "start" });
              // 使用 replaceState 避免在历史记录中留下锚点
              const url = window.location.pathname + (targetId ? `#${targetId}` : "");
              window.history.replaceState(null, "", url);
              // 更新激活状态
              updateActiveLink();
            }
          });
        });

        // 页面加载时，如果有锚点，高亮对应的链接
        updateActiveLink();

        // 监听浏览器前进/后退
        window.addEventListener("popstate", () => {
          updateActiveLink();
          const hash = window.location.hash;
          if (hash) {
            const target = document.getElementById(hash.substring(1));
            if (target) {
              target.scrollIntoView({ behavior: scrollBehavior, block: "start" });
            }
          }
        });
      });
    </script>

    <!-- Client-side visibility filter: reads hidden IDs from Supabase and hides posts -->
    <script is:inline>
      (function () {
        if (!window.__bxHiddenPosts) return;
        try {
          window.__bxHiddenPosts
            .then(function (rows) {
              var hidden = (Array.isArray(rows) && rows[0] && Array.isArray(rows[0].hidden_posts))
                ? rows[0].hidden_posts.map(function (s) { return String(s).trim().toLowerCase(); })
                : [];
              var homeFeed = document.querySelector('.home-feed[data-home-runtime-endpoint]');
              if (hidden.length) {
                hidden.forEach(function (id) {
                  var selector = '[data-post-id="' + id + '"]';
                  var els = document.querySelectorAll(selector);
                  for (var i = 0; i < els.length; i++) {
                    if (homeFeed && homeFeed.contains(els[i])) continue;
                    els[i].style.display = "none";
                  }
                });
              }

              // Hide empty category/archive sections after filtering
              var sections = document.querySelectorAll('.cat-section, .fluid-category-section, .fluid-list-group');
              for (var i = 0; i < sections.length; i++) {
                var links = sections[i].querySelectorAll('[data-post-id]');
                if (!links.length) continue;
                var allHidden = true;
                for (var j = 0; j < links.length; j++) {
                  if (links[j].style.display !== 'none') { allHidden = false; break; }
                }
                if (allHidden) sections[i].style.display = 'none';
              }
            })
            .catch(function () { /* Supabase unreachable, skip client-side filter */ });
        } catch (_) {}
      })();
    </script>
  </body>
</html>