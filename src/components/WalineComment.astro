---
const {
  class: className = '',
  serverURL = import.meta.env.PUBLIC_WALINE_SERVER_URL || '',
  path = Astro.url.pathname,
} = Astro.props;
---

<div id="waline" class:list={['not-prose', className]} data-server-url={serverURL} data-path={path}>
  <p class="comment-status">{serverURL ? 'Loading comments…' : 'Comments are not configured.'}</p>
</div>

<script>
  const container = document.querySelector<HTMLElement>('#waline');
  if (container?.dataset.serverUrl) {
    const loadComments = async () => {
      const stylesheet = document.createElement('link');
      stylesheet.rel = 'stylesheet';
      stylesheet.href = 'https://unpkg.com/@waline/client@2.15.8/dist/waline.css';
      document.head.append(stylesheet);
      try {
        await new Promise<void>((resolve, reject) => {
          const script = document.createElement('script');
          script.src = 'https://unpkg.com/@waline/client@2.15.8/dist/waline.js';
          script.onload = () => resolve();
          script.onerror = () => reject(new Error('Comment service unavailable'));
          document.head.append(script);
        });
        const waline = (window as Window & { Waline?: { init: (options: Record<string, unknown>) => void } }).Waline;
        if (!waline) throw new Error('Comment service unavailable');
        container.replaceChildren();
        waline.init({
          el: container,
          serverURL: container.dataset.serverUrl,
          path: container.dataset.path,
          emoji: ['weibo', 'alus', 'bilibili', 'qq'],
          locale: { placeholder: '欢迎留言~(支持Markdown语法)' },
          reaction: [],
          dark: 'html.dark',
          pageview: true,
          comment: true,
        });
      } catch {
        container.textContent = 'Comments could not load. Refresh to try again.';
      }
    };
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void loadComments();
      }, { rootMargin: '400px' });
      observer.observe(container);
    } else {
      void loadComments();
    }
  }
</script>

<style is:global>
  #waline {
    min-height: 120px;
    --waline-theme-color: var(--text-link);
    --waline-active-color: var(--text-link-hover);
    --waline-text-color: var(--text-primary);
    --waline-bg-color: var(--bg-secondary);
    --waline-bg-color-light: var(--bg-tertiary);
    --waline-border-color: var(--border-color);
    --waline-font-size: 1rem;
    --waline-font-family: var(--font-family-sans-serif);
  }
  #waline .comment-status { color: var(--text-secondary); }
  #waline .wl-btn-primary { color: #fff; }
</style>
