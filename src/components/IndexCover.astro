---
import { defaultHeroImage } from '../lib/site-images';

interface Props { title: string }
const { title } = Astro.props;
const image = defaultHeroImage(import.meta.env.BASE_URL);
---

<section class="index-cover" aria-labelledby="page-title" style={{ '--cover-image': `url(${JSON.stringify(image)})` }}>
  <h1 id="page-title">{title}</h1>
  <a href="#fluid-board" class="index-cover-scroll" aria-label={`Scroll to ${title}`}>
    <i class="iconfont icon-arrowdown" aria-hidden="true"></i>
  </a>
</section>

<style>
  /* Same photo fade as website/src/styles/theme.css and site-pages.css. */
  .index-cover {
    position: relative;
    isolation: isolate;
    height: clamp(280px, 39svh, 410px);
    background: linear-gradient(180deg, rgba(13,15,18,.27), rgba(13,15,18,.19) 35%, rgba(13,15,18,.85) 87%, #0d0f12), var(--cover-image) center 47% / cover;
  }
  .index-cover::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    mask-image: linear-gradient(transparent 20%, #000 92%);
    -webkit-mask-image: linear-gradient(transparent 20%, #000 92%);
    pointer-events: none;
  }
  h1 {
    position: absolute;
    inset: 45% 24px auto;
    transform: translateY(-50%);
    margin: 0;
    color: #eceef1;
    text-align: center;
    font-size: clamp(27px, 3vw, 34px);
    font-weight: 500;
    letter-spacing: .025em;
  }
  .index-cover-scroll {
    position: absolute;
    bottom: 76px;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: #d4d8df;
    text-decoration: none;
  }
  .index-cover-scroll:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media (max-width: 760px) { .index-cover { height: 300px; } }
</style>
