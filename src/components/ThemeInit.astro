<script is:inline>
  (function () {
    var theme = 'light';
    try {
      theme = localStorage.getItem('preferred-theme') || localStorage.getItem('bx-home-preview-theme') || 'light';
    } catch (_) {}
    document.documentElement.dataset.theme = theme === 'dark' ? 'dark' : 'light';
    document.documentElement.classList.toggle('dark', theme === 'dark');
  })();
</script>
