---
import { withBase } from '../lib/base-url';
const { overlay = false, home = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [[withBase(base, '#notes'), 'Articles'], [withBase(base, 'archives/'), 'Archives'], [withBase(base, 'categories/'), 'Categories'], [withBase(base, 'about/'), 'About']];
// Original Fluid glyphs, isolated from page-level iconfont rules.
const icons: Record<string, string> = { Articles: '\uf017', Archives: '\uef1c', Categories: '\ue60d', About: '\uf12c' };
const pathname = Astro.url.pathname;
const activeUrl = pathname;
---

<header class:list={['site-header', !overlay && 'is-solid']}>
  <a class="wordmark" href={withBase(base, '')}><img class="nav-avatar" src={withBase(base, 'profile-avatar.webp')} width="30" height="30" alt="" />AAAAAZBX<span class="wordmark-dot">.</span></a>
  <button class="nav-toggle" type="button" aria-controls="primary-navigation" aria-expanded="false" aria-label="Open navigation">
    <span>Menu</span>
    <svg viewBox="0 0 20 20" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true" focusable="false"><path d="M4 7h12M4 13h12" /></svg>
  </button>
  <nav id="primary-navigation" aria-label="Main navigation">
    {links.map(([url, label]) => <a href={url} aria-current={activeUrl === url ? (pathname === url ? 'page' : 'location') : undefined}><span class="nav-icon" aria-hidden="true">{icons[label]}</span><span>{label}</span></a>)}
  </nav>
</header>
{!overlay && <div class="site-header-space" aria-hidden="true"></div>}

<style is:global>
  @font-face {
    font-family: 'SiteNavIcons';
    src: url('../assets/fonts/fluid-nav-icons.woff2') format('woff2');
    font-weight: normal;
    font-style: normal;
    font-display: block;
  }
  body .site-header nav a { gap: 7px; }
  body .site-header .nav-icon { display: inline-block; width: 16px; height: 16px; flex-shrink: 0; margin: 0; font: normal 16px/1 'SiteNavIcons'; text-align: center; letter-spacing: normal; -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
  body .site-header .wordmark .nav-avatar { width: 30px; height: 30px; flex-shrink: 0; object-fit: cover; border-radius: 50%; margin: 0 5px 0 0; }
  html { --site-header-height: 64px; }
  html[data-theme] body header.site-header {
    position: fixed; inset: 0 0 auto; z-index: 1000;
    width: 100%; max-width: none; height: 64px; margin: 0;
    padding: 0 max(24px, calc((100% - 1060px) / 2));
    display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 24px;
    box-sizing: border-box; border: 0; border-radius: 0; box-shadow: none;
    color: #dedfe3; background: rgba(var(--dark-rgb, 13, 15, 18), .5);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
    line-height: normal; letter-spacing: normal;
    transition: transform .2s ease, background-color .2s ease;
  }
  html[data-theme] body header.site-header:is(.is-scrolled, .is-solid) { background: rgba(var(--dark-rgb, 13, 15, 18), .92); }
  html[data-theme] body header.site-header.is-hidden { transform: translateY(calc(-100% - 1px)); }
  html[data-theme] body header.site-header:has(:focus-visible) { transform: none; }
  body .site-header-space { height: var(--site-header-height); }
  body .skip { z-index: 1100; }
  body .site-header a { color: inherit; text-decoration: none; }
  body .site-header :is(a, button):focus-visible { outline: 2px solid #b7cfe7; outline-offset: 4px; border-radius: 5px; }
  body .site-header .wordmark { display: inline-flex; align-items: center; gap: 5px; font-size: 18px; font-weight: 600; letter-spacing: -.6px; white-space: nowrap; }
  body .site-header .wordmark-dot { color: #c4c8d0; }
  body .site-header nav { display: flex; align-items: center; flex-wrap: nowrap; width: auto; gap: 20px; }
  body .site-header nav a { display: flex; align-items: center; min-height: 44px; padding: 0 8px; font-size: 13px; font-weight: 400; opacity: .68; border-radius: 6px; transition: opacity .15s ease, background-color .15s ease; }
  body .site-header nav a::after { display: none; }
  body .site-header nav a[aria-current] { opacity: 1; text-decoration: none; }
  body .site-header nav a:hover { opacity: 1; background: #ffffff06; }
  body .site-header .nav-toggle { display: none; align-items: center; justify-content: center; gap: 9px; min-height: 44px; padding: 0 4px 0 12px; border: 0; background: transparent; color: inherit; font: inherit; font-size: 12px; cursor: pointer; }
  body .site-header .nav-toggle svg { display: block; width: 18px; height: 18px; margin: 0; color: inherit; }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    html[data-theme] body header.site-header { background: var(--dark-bg, #0d0f12); }
  }
  @media (max-width: 760px) {
    html { --site-header-height: 56px; }
    html[data-theme] body header.site-header { height: auto; min-height: 56px; padding: 0 20px; gap: 0 12px; flex-wrap: wrap; }
    body .site-header .wordmark { min-height: 56px; font-size: 17px; }
    body .site-header nav { width: 100%; justify-content: space-between; gap: 0; padding-bottom: 8px; }
    body .site-header nav a { font-size: 12px; }
    html[data-theme] body header.site-header.is-enhanced { height: 56px; flex-wrap: nowrap; }
    body .site-header.is-enhanced .nav-toggle { display: inline-flex; }
    body .site-header.is-enhanced nav {
      display: none; position: absolute; top: calc(100% + 8px); right: 16px; justify-content: stretch; gap: 2px;
      width: min(240px, calc(100vw - 32px)); padding: 8px; border-radius: 14px;
      background: var(--dark-panel, #1a1d22); box-shadow: 0 12px 36px #0005;
    }
    body .site-header.is-enhanced.is-menu-open nav { display: grid; }
    body .site-header.is-enhanced nav a { min-height: 44px; padding: 0 14px; }
    body .site-header.is-enhanced nav a[aria-current] { background: #ffffff06; }
  }
  @media (prefers-reduced-motion: reduce) {
    html[data-theme] body header.site-header,
    body .site-header nav a { transition: none; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.nav-toggle');
  const navigation = header?.querySelector<HTMLElement>('nav');

  if (header && toggle && navigation) {
    header.classList.add('is-enhanced');
    const mobile = window.matchMedia('(max-width: 760px)');
    let previousY = Math.max(0, window.scrollY);
    let distance = 0;
    let scheduled = false;

    const reveal = () => header.classList.remove('is-hidden');
    const setMenu = (open: boolean) => {
      header.classList.toggle('is-menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      const label = toggle.querySelector('span');
      if (label) label.textContent = open ? 'Close' : 'Menu';
      if (open) reveal();
    };

    const updateScroll = () => {
      scheduled = false;
      const maxY = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
      const y = Math.min(maxY, Math.max(0, window.scrollY));
      const delta = y - previousY;
      previousY = y;
      header.classList.toggle('is-scrolled', y > 16);

      if (y < header.offsetHeight + 24 || header.querySelector(':focus-visible') || header.classList.contains('is-menu-open')) {
        reveal();
        distance = 0;
        return;
      }
      if (!delta) return;
      distance = Math.sign(delta) === Math.sign(distance) ? distance + delta : delta;
      if (Math.abs(distance) >= 12) {
        header.classList.toggle('is-hidden', distance > 0);
        distance = 0;
      }
    };

    window.addEventListener('scroll', () => {
      if (!scheduled) {
        scheduled = true;
        window.requestAnimationFrame(updateScroll);
      }
    }, { passive: true });
    header.addEventListener('focusin', reveal);
    toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
    navigation.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) setMenu(false);
    });
    document.addEventListener('pointerdown', (event) => {
      if (event.target instanceof Node && !header.contains(event.target)) setMenu(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && header.classList.contains('is-menu-open')) {
        setMenu(false);
        toggle.focus();
      }
    });
    header.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !header.contains(event.relatedTarget)) setMenu(false);
    });
    mobile.addEventListener('change', () => setMenu(false));
    new ResizeObserver(() => {
      document.documentElement.style.setProperty('--site-header-height', header.offsetHeight + 'px');
    }).observe(header);
    updateScroll();
  }
</script>
